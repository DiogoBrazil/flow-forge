{
  "schemaVersion": 1,
  "exportedAt": "2026-11-20T16:00:00.000Z",
  "project": {
    "id": "real-system-distributed-commerce",
    "name": "Sistema Real 2 — Plataforma de E-Commerce Distribuída",
    "description": "Sistema distribuído anonimizado com serviços, PostgreSQL, Redis, Kafka, PSP externo e arquitetura interna com Boundary Binding.",
    "ruleProfile": "hexagonal",
    "createdAt": "2026-11-20T16:00:00.000Z",
    "updatedAt": "2026-11-20T16:00:00.000Z",
    "topology": {
      "nodes": [
        {
          "id": "broker-kafka",
          "name": "Kafka Event Bus",
          "kind": "broker",
          "description": "Eventos de domínio de checkout e expedição",
          "technology": "Apache Kafka"
        },
        {
          "id": "cache-redis",
          "name": "Redis Cart Cache",
          "kind": "cache",
          "description": "Carrinhos ativos e locks de idempotência",
          "technology": "Redis 7"
        },
        {
          "id": "client-storefront",
          "name": "Storefront SPA",
          "kind": "client",
          "description": "Loja web dos compradores",
          "technology": "Vue 3"
        },
        {
          "id": "db-checkout",
          "name": "PostgreSQL Checkout",
          "kind": "database",
          "description": "Persistência de pedidos confirmados",
          "technology": "PostgreSQL 16"
        },
        {
          "id": "ext-psp",
          "name": "Payment PSP",
          "kind": "external-system",
          "description": "Adquirente externo de cartões e PIX",
          "technology": "REST API"
        },
        {
          "id": "gw-api",
          "name": "API Gateway",
          "kind": "gateway",
          "description": "Roteamento e autenticação JWT",
          "technology": "Kong"
        },
        {
          "id": "svc-catalog",
          "name": "Catalog API",
          "kind": "service",
          "description": "Consulta de preços e estoque disponível",
          "technology": "Go"
        },
        {
          "id": "svc-checkout",
          "name": "Checkout API",
          "kind": "service",
          "description": "Orquestra fechamento de carrinho, cobrança e publicação de evento",
          "technology": "TypeScript"
        },
        {
          "id": "svc-fulfillment",
          "name": "Fulfillment Worker",
          "kind": "service",
          "description": "Consome pedidos pagos para separação logística",
          "technology": "Go"
        }
      ],
      "connections": [
        {
          "id": "c-chk-broker",
          "sourceId": "svc-checkout",
          "targetId": "broker-kafka",
          "kind": "async-publish",
          "protocol": "kafka",
          "label": "checkout.paid"
        },
        {
          "id": "c-chk-catalog",
          "sourceId": "svc-checkout",
          "targetId": "svc-catalog",
          "kind": "sync-call",
          "protocol": "grpc",
          "label": "ReserveStock"
        },
        {
          "id": "c-chk-db",
          "sourceId": "svc-checkout",
          "targetId": "db-checkout",
          "kind": "data-access",
          "protocol": "sql",
          "label": "checkout_db"
        },
        {
          "id": "c-chk-psp",
          "sourceId": "svc-checkout",
          "targetId": "ext-psp",
          "kind": "sync-call",
          "protocol": "http",
          "label": "POST /charges"
        },
        {
          "id": "c-chk-redis",
          "sourceId": "svc-checkout",
          "targetId": "cache-redis",
          "kind": "cache-access",
          "protocol": "redis",
          "label": "cart:{id}"
        },
        {
          "id": "c-gw-chk",
          "sourceId": "gw-api",
          "targetId": "svc-checkout",
          "kind": "sync-call",
          "protocol": "http",
          "label": "POST /checkout"
        },
        {
          "id": "c-kafka-fulfill",
          "sourceId": "broker-kafka",
          "targetId": "svc-fulfillment",
          "kind": "async-consume",
          "protocol": "kafka",
          "label": "checkout.paid"
        },
        {
          "id": "c-spa-gw",
          "sourceId": "client-storefront",
          "targetId": "gw-api",
          "kind": "sync-call",
          "protocol": "http",
          "label": "HTTPS"
        }
      ]
    },
